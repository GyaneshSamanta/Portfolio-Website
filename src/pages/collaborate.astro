---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Correspond - Gyanesh Samanta">
  <section class="mt-4 max-w-xl mx-auto">
    <header class="mb-10 flex items-center justify-between border-b border-border pb-4">
      <h1 class="text-2xl font-medium text-ink">Correspond</h1>
      <span class="text-[10px] uppercase tracking-widest font-sans text-ink-light">Contact</span>
    </header>
    
    <p class="text-[16px] text-ink leading-[1.65] text-justify mb-10">
      Whether you seek a product consultation, wish to explore a new venture, or simply desire an intellectual exchange regarding B2B SaaS and Artificial Intelligence, I am always open to compelling conversations.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 no-underline-links">
      <a href="https://cal.com/gyanesh-samanta" target="_blank" class="flex-1 py-3 border border-ink bg-ink text-white font-sans text-[11px] font-medium uppercase tracking-[0.1em] hover:bg-white hover:text-ink transition-colors text-center shadow-sm rounded-sm">
        Book a Consultation
      </a>
      <a href="https://www.linkedin.com/in/gyanesh-samanta/" target="_blank" class="flex-1 py-3 border border-border bg-white text-ink font-sans text-[11px] font-medium uppercase tracking-[0.1em] hover:bg-[#EFECE6] transition-colors text-center shadow-sm rounded-sm">
        Connect via LinkedIn
      </a>
    </div>
  </section>
</Layout>
