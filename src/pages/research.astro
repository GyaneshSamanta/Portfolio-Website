---
import Layout from '../layouts/Layout.astro';
import workData from '../data/work.json';
---
<Layout title="Research - Gyanesh Samanta">
  <section class="mt-4">
    <header class="mb-10 flex items-center justify-between border-b border-border pb-4">
      <h1 class="text-2xl font-medium text-ink">Research & Treatises</h1>
      <span class="text-[10px] uppercase tracking-widest font-sans text-ink-light">IEEE Publications</span>
    </header>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {workData.map((project) => (
        <article class="flex flex-col border border-border p-6 bg-white rounded-sm shadow-sm h-full">
          <div class="text-[10px] font-sans uppercase tracking-[0.1em] text-ink-light mb-2">{project.subtitle}</div>
          <h3 class="text-[18px] font-medium text-ink leading-snug mb-3 flex-grow">{project.title}</h3>
          
          <p class="text-[14px] text-ink-light leading-[1.65] text-justify mb-5">
            {project.description}
          </p>
          
          <div class="flex flex-wrap gap-x-4 gap-y-2 no-underline-links mt-auto pt-4 border-t border-border/50">
            {project.links && project.links.map((link: any) => (
              <a href={link.url} target="_blank" class="text-[11px] font-sans font-medium text-ink hover:text-ink-light flex items-center gap-1 uppercase tracking-widest">
                {link.label} &nearr;
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
